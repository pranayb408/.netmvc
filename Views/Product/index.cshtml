@model List<ProductStoreMVC.Models.Product>

@{
    ViewData["Title"] = "Product Store";

    var customerName =
        Context.Request.Cookies["CustomerName"];

    var selectedCategory =
        Context.Session.GetString("SelectedCategory");
}

<div class="container mt-4 mb-5">

    <!-- HEADER -->

    <div class="text-center mb-4">

        <h1 class="fw-bold">
            Product Store
        </h1>

        <p class="text-muted">
            Products with MRP, Discount and Final Selling Price
        </p>

    </div>


    <!-- CUSTOMER COOKIE -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Customer Information
            </h5>

        </div>

        <div class="card-body">

            <form asp-controller="Product"
                  asp-action="SetCustomerName"
                  method="post">

                <div class="row g-2">

                    <div class="col-md-9">

                        <input type="text"
                               name="customerName"
                               class="form-control"
                               placeholder="Enter customer name"
                               value="@customerName"
                               required />

                    </div>

                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Save Customer Name

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- SESSION CATEGORY -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-secondary text-white">

            <h5 class="mb-0">
                Product Category
            </h5>

        </div>

        <div class="card-body">

            <form asp-controller="Product"
                  asp-action="SetCategory"
                  method="post">

                <div class="row g-2">

                    <div class="col-md-9">

                        <select name="category"
                                class="form-select">

                            <option value="electronics">
                                Electronics
                            </option>

                            <option value="jewelery">
                                Jewelery
                            </option>

                            <option value="men's clothing">
                                Men's Clothing
                            </option>

                            <option value="women's clothing">
                                Women's Clothing
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-secondary w-100">

                            Save Category

                        </button>

                    </div>

                </div>

            </form>

            @if (!string.IsNullOrEmpty(selectedCategory))
            {
                <div class="mt-3">

                    <span class="badge bg-info text-dark">

                        Selected Category:
                        @selectedCategory

                    </span>

                </div>
            }

        </div>

    </div>


    <!-- ORDER MESSAGE -->

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">

            @TempData["Message"]

        </div>
    }


    <!-- PRODUCT LIST -->

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <div class="d-flex justify-content-between">

                <h4 class="mb-0">
                    Product List
                </h4>

                <span class="badge bg-light text-dark">

                    @(Model?.Count ?? 0) Products

                </span>

            </div>

        </div>


        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th class="text-center">
                                Product ID
                            </th>

                            <th>
                                Product Name
                            </th>

                            <th>
                                Category
                            </th>

                            <th class="text-end">
                                MRP
                            </th>

                            <th class="text-center">
                                Discount %
                            </th>

                            <th class="text-end">
                                Discount Amount
                            </th>

                            <th class="text-end">
                                Final Selling Price
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var product in Model)
                        {
                            decimal discountAmount =
                                product.Price *
                                product.DiscountPercentage /
                                100m;

                            decimal finalSellingPrice =
                                product.Price -
                                discountAmount;

                            <tr>

                                <!-- ID -->

                                <td class="text-center fw-bold">

                                    @product.ProductId

                                </td>


                                <!-- NAME -->

                                <td>

                                    <strong>
                                        @product.ProductName
                                    </strong>

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    <span class="badge bg-light text-dark border">

                                        @product.Category

                                    </span>

                                </td>


                                <!-- MRP -->

                                <td class="text-end">

                                    <strong>

                                        ₹@product.Price.ToString("N2")

                                    </strong>

                                </td>


                                <!-- DISCOUNT % -->

                                <td class="text-center">

                                    <span class="badge bg-danger">

                                        @product.DiscountPercentage.ToString("0.##")%

                                    </span>

                                </td>


                                <!-- DISCOUNT AMOUNT -->

                                <td class="text-end">

                                    <span class="text-danger fw-bold">

                                        - ₹@discountAmount.ToString("N2")

                                    </span>

                                </td>


                                <!-- FINAL SELLING PRICE -->

                                <td class="text-end">

                                    <span class="text-success fw-bold fs-5">

                                        ₹@finalSellingPrice.ToString("N2")

                                    </span>

                                </td>


                                <!-- DETAILS -->

                                <td class="text-center">

                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-primary btn-sm">

                                        Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-warning m-3 text-center">

                <h5>
                    No Products Available
                </h5>

                <p class="mb-0">

                    Unable to retrieve products
                    from Fake Store API.

                </p>

            </div>
        }

    </div>


    <!-- FEATURES -->

    <div class="row mt-4 g-3">

        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h5 class="text-primary">
                        Cookie
                    </h5>

                    <p class="text-muted small">
                        Stores customer name.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h5 class="text-secondary">
                        Session
                    </h5>

                    <p class="text-muted small">
                        Stores selected category.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h5 class="text-success">
                        Query String
                    </h5>

                    <p class="text-muted small">
                        Passes Product ID to details.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h5 class="text-warning">
                        IMemoryCache
                    </h5>

                    <p class="text-muted small">
                        Product list cached for 10 minutes.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>